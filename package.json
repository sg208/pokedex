{
  "name": "pokedex",
  "version": "0.3.2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "fix": "pnpm lint:fix && pnpm format",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,vue,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,vue,json,css,md}\"",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "build": "nuxt generate",
    "deploy": "pnpm generate && wrangler deploy",
    "data:refresh": "node --experimental-strip-types scripts/build-dex-index.ts"
  },
  "dependencies": {
    "@nuxt/icon": "^2.1.0",
    "@nuxt/ui": "^4.1.0",
    "@tanstack/vue-query": "^5.59.0",
    "@vueuse/core": "^14.0.0",
    "nuxt": "^4.2.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@fontsource-variable/tiktok-sans": "^5.3.0",
    "@nuxt/eslint": "^1.10.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@10.34.8",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "vue-demi",
      "unrs-resolver",
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "fontless>esbuild": "^0.28.1"
    }
  }
}
